# Required: Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Optional: Polygon.io API key for real market data
# If not set, the built-in market simulator is used (recommended)
MASSIVE_API_KEY=

# Optional: Set to "true" to use mock LLM responses (for testing)
LLM_MOCK=false
